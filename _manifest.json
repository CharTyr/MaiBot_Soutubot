{
  "manifest_version": 2,
  "id": "chartyr.soutubot",
  "version": "0.3.0",
  "name": "SoutubotSearch",
  "description": "Soutubot + SauceNAO + Google Lens 以图搜源：漫画本子与插画出处（创作者平台优先）",
  "author": {
    "name": "CharTyr",
    "url": "https://github.com/CharTyr"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/CharTyr/MaiBot_Soutubot",
    "homepage": "https://github.com/CharTyr/MaiBot_Soutubot",
    "documentation": "https://github.com/CharTyr/MaiBot_Soutubot",
    "issues": "https://github.com/CharTyr/MaiBot_Soutubot/issues"
  },
  "host_application": {
    "min_version": "1.0.12",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.25.0"
    }
  ],
  "capabilities": [
    "message.get_by_id",
    "api.call",
    "send.text",
    "send.image",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "search"
    }
  }
}
